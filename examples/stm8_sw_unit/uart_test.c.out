int main(void) {
  CLK_CKDIVR = 0x00;
  uart_init(16000000UL, 9600); // init UART1 at 9600 baud, 16 MHz HSI

  while (1) {
   // uart_putc('y');
    uart_puts("Hello bare-metal!\r\n");
    delay_ms(1000);
  }
}
