
[env:stm8]
platform = ststm8
board = stm8s003f3
framework = arduino
extends = env_common
build_src_filter = 
    +<../examples/STM8_sw_unit/*.c>
    +<../examples/STM8_sw_unit/*.cpp>
    -<*>
build_flags =
    ${env_common.build_flags}
    -DSTM8
    -Iexamples/STM8_sw_unit   ; only if you have headers there
    ;-U_F_CPU -DF_CPU=12000000UL
    ;-DHSE_VALUE=12000000


; Debug build flags — don't treat warnings as errors
;build_flags_debug = -Wno-error

; This is the key line. It forces the entire project,
; including the framework, to be built for 12MHz.
board_build.f_cpu = 12000000L

; Upload using ST-LINK
upload_protocol = stlinkv2

; Optional: specify the serial port for PL2303 UART monitor
; Replace /dev/ttyUSB0 with the actual port detected on your system
monitor_port = /dev/ttyUSB0
monitor_speed = 7200
;monitor_speed = 9600